<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arms_target_manager</name>
  <version>1.5.0</version>
  <description>Interactive marker-based target manager for arms control</description>
  <maintainer email="arms@example.com">Arms Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>arms_ros2_control_msgs</depend>
  <depend>arms_controller_common</depend>
  <!-- arms_rviz_control_plugin: declared previously but never included or linked;
       it is Qt/rviz-panel only and not part of the Foxy port. -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <!-- JointState is used directly; on Jazzy this only came in transitively. -->
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>controller_manager_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
