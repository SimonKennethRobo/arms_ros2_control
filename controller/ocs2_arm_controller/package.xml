<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
	<name>ocs2_arm_controller</name>
	<version>2.2.0</version>
	<description>A Ros2 Control Controller for OCS2 Arm Control</description>
	<maintainer email="biao876990970@hotmail.com">Huang Zhenbiao</maintainer>
	<license>Apache-2.0</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<depend>controller_interface</depend>
	<depend>pluginlib</depend>
	<depend>ament_index_cpp</depend>
	<depend>ocs2_mobile_manipulator</depend>
	<depend>std_msgs</depend>
	<depend>arms_ros2_control_msgs</depend>
	<depend>arms_controller_common</depend>
	<depend>ocs2_controller_common</depend>

	<exec_depend>robot_common_launch</exec_depend>
	<exec_depend>arms_target_manager</exec_depend>
	<exec_depend>controller_manager</exec_depend>
	<exec_depend>ament_index_python</exec_depend>
	<exec_depend>launch</exec_depend>
	<exec_depend>launch_ros</exec_depend>
	<exec_depend>rviz2</exec_depend>
	<exec_depend>python3-yaml</exec_depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>
</package> 
