<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>arms_controller_common</name>
    <version>1.5.0</version>
    <description>Common libraries for arm controllers including FSM and gravity compensation</description>
    <maintainer email="biao876990970@hotmail.com">Huang Zhenbiao</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>hardware_interface</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>pinocchio</depend>
    <depend>urdf</depend>
    <depend>ament_index_cpp</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>arms_ros2_control_msgs</depend>
    <!-- Used by StateMoveJ (JointTrajectory / Float64MultiArray) but previously
         only pulled in transitively. -->
    <depend>trajectory_msgs</depend>
    <depend>std_msgs</depend>
    <!-- lina_planning is find_package(... QUIET) and guarded by HAS_LINA_PLANNING;
         it is a private submodule, so a hard depend here only makes rosdep fail. -->
    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
