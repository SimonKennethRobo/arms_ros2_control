<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ocs2_controller_common</name>
  <version>1.5.0</version>
  <description>Shared OCS2 + ros2_control building blocks (reference targets, Pinocchio visualization, MPC timing helpers).</description>
  <maintainer email="biao876990970@hotmail.com">Huang Zhenbiao</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>arms_ros2_control_msgs</depend>
  <!-- Everything find_package()'d as REQUIRED by CMakeLists.txt. -->
  <depend>ocs2_core</depend>
  <depend>ocs2_oc</depend>
  <depend>ocs2_mpc</depend>
  <depend>ocs2_pinocchio_interface</depend>
  <depend>ocs2_self_collision</depend>
  <depend>ocs2_self_collision_visualization</depend>
  <depend>ocs2_ros_interfaces</depend>
  <!-- lina_planning and ocs2_wheel_humanoid are find_package(... QUIET) in
       CMakeLists.txt and guarded behind HAS_LINA_PLANNING / HAS_OCS2_WHEEL_HUMANOID.
       They are private submodules, so declaring them here only makes rosdep fail.
       ocs2_mobile_manipulator_ros was declared but never find_package()'d. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
